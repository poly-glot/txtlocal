#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

bash scripts/check.sh
if [ -f frontend/package.json ]; then
    pnpm --dir frontend check
fi

command -v codegraph >/dev/null 2>&1 && codegraph sync >/dev/null 2>&1 || true
command -v zg >/dev/null 2>&1 && zg index >/dev/null 2>&1 || true
